# Copy to .env and adjust. docker compose and the Makefile both read .env.

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=workout
POSTGRES_PASSWORD=workout
POSTGRES_DB=workout
# Host port Postgres is published on. Change it (and DATABASE_URL) if 5432 is taken locally.
POSTGRES_HOST_PORT=5432

# Connection string used by the API and migrations — keep in sync with the values above
DATABASE_URL=postgres://workout:workout@localhost:5432/workout?sslmode=disable

# Port the Go API listens on
PORT=8080
